JWT_SECRET_KEY=
DATABASE_URL=
DATASET_ROOT=
REGISTRATION_CODE=

# Set to false in production to hide /api/docs, /api/redoc, and /api/openapi.json
EXPOSE_API_DOCS=true

# Optional: shown in the About → Developer Info panel. Run `docker version --format '{{.Server.Version}}'` to get this.
DOCKER_VERSION=29.5.2

# --- Tailscale Funnel deployment only ---
# Generate an auth key at https://login.tailscale.com/admin/settings/keys
# Use a reusable, ephemeral key tagged with tag:container (recommended)
TAILSCALE_AUTH_KEY=
# Optional: hostname for the Tailscale node (default: medfabric)
TAILSCALE_HOSTNAME=medfabric

# --- Telegram notifications (optional) ---
# Create a bot via @BotFather, then add it to a group/channel and get the chat ID.
# Leave both empty to disable all Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Timezone for the 09:00 / 21:00 scheduled reports (IANA tz name)
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh
